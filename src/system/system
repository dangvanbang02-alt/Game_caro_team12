#ifndef SAVEGAME_H
#define SAVEGAME_H

#include <stdio.h>
#include <string.h>

#ifdef _WIN32
  #include <direct.h>
  #define SG_MKDIR(path) _mkdir(path)
#else
  #include <sys/stat.h>
  #define SG_MKDIR(path) mkdir(path, 0755)
#endif

#define MAX_SIZE      20
#define MAX_MOVES     (MAX_SIZE * MAX_SIZE)
#define SAVE_DIR      "saves"
#define SAVE_MAGIC    "CARO_SAVE"
#define SAVE_VERSION  1

#define CELL_EMPTY 0
#define CELL_X     1
#define CELL_O     2

#define MODE_PVP 0
#define MODE_PVE 1

#define LEVEL_EASY   0
#define LEVEL_MEDIUM 1
#define LEVEL_HARD   2

typedef struct {
    int row, col, player;
} Move;

typedef struct {
    int  size;
    int  board[MAX_SIZE][MAX_SIZE];
    int  currentPlayer;
    int  mode;
    int  botLevel;
    int  winLength;
    int  moveCount;
    Move history[MAX_MOVES];
} GameState;

typedef enum {
    SAVE_OK = 0,
    SAVE_ERR_OPEN,
    SAVE_ERR_FORMAT,
    SAVE_ERR_VERSION,
    SAVE_ERR_DATA,
    SAVE_ERR_NOT_FOUND,
    SAVE_ERR_KEY_CONFLICT
} SaveResult;

static FILE *sg_open(const char *name, const char *mode)
{
    FILE *f = NULL;
#ifdef _MSC_VER
    if (fopen_s(&f, name, mode) != 0) return NULL;
#else
    f = fopen(name, mode);
#endif
    return f;
}

static int sg_validPlayer(int p) { return p == CELL_X || p == CELL_O; }

static int sg_validate(const GameState *g)
{
    if (g->size < 3 || g->size > MAX_SIZE)                    return 0;
    if (g->winLength < 3 || g->winLength > g->size)           return 0;
    if (!sg_validPlayer(g->currentPlayer))                    return 0;
    if (g->mode != MODE_PVP && g->mode != MODE_PVE)           return 0;
    if (g->botLevel < LEVEL_EASY || g->botLevel > LEVEL_HARD) return 0;
    if (g->moveCount < 0 || g->moveCount > g->size * g->size) return 0;

    for (int i = 0; i < g->size; i++)
        for (int j = 0; j < g->size; j++)
            if (g->board[i][j] < CELL_EMPTY || g->board[i][j] > CELL_O) return 0;

    for (int k = 0; k < g->moveCount; k++) {
        const Move *m = &g->history[k];
        if (m->row < 0 || m->row >= g->size) return 0;
        if (m->col < 0 || m->col >= g->size) return 0;
        if (!sg_validPlayer(m->player))      return 0;
    }
    return 1;
}

static void sg_slotPath(char *buf, size_t n, int slot)
{
    snprintf(buf, n, "%s/slot%d.sav", SAVE_DIR, slot);
}

static void initGame(GameState *g, int size, int winLength, int mode, int botLevel)
{
    memset(g, 0, sizeof(*g));
    g->size = size;
    g->winLength = winLength;
    g->mode = mode;
    g->botLevel = botLevel;
    g->currentPlayer = CELL_X;
}

static int applyMove(GameState *g, int row, int col)
{
    if (row < 0 || row >= g->size || col < 0 || col >= g->size) return 0;
    if (g->board[row][col] != CELL_EMPTY) return 0;
    if (g->moveCount >= MAX_MOVES) return 0;

    g->board[row][col] = g->currentPlayer;
    g->history[g->moveCount].row = row;
    g->history[g->moveCount].col = col;
    g->history[g->moveCount].player = g->currentPlayer;
    g->moveCount++;
    g->currentPlayer = (g->currentPlayer == CELL_X) ? CELL_O : CELL_X;
    return 1;
}

static SaveResult saveGame(const GameState *g, const char *filename)
{
    SG_MKDIR(SAVE_DIR);
    FILE *f = sg_open(filename, "w");
    if (!f) return SAVE_ERR_OPEN;

    fprintf(f, "%s %d\n", SAVE_MAGIC, SAVE_VERSION);
    fprintf(f, "%d %d %d %d %d %d\n", g->size, g->winLength, g->mode,
            g->botLevel, g->currentPlayer, g->moveCount);

    for (int i = 0; i < g->size; i++) {
        for (int j = 0; j < g->size; j++) fprintf(f, "%d ", g->board[i][j]);
        fprintf(f, "\n");
    }
    for (int k = 0; k < g->moveCount; k++)
        fprintf(f, "%d %d %d\n", g->history[k].row, g->history[k].col, g->history[k].player);
    fprintf(f, "END\n");

    int err = ferror(f);
    fclose(f);
    return err ? SAVE_ERR_OPEN : SAVE_OK;
}

static SaveResult loadGame(GameState *g, const char *filename)
{
    FILE *f = sg_open(filename, "r");
    if (!f) return SAVE_ERR_NOT_FOUND;

    GameState tmp;
    memset(&tmp, 0, sizeof(tmp));

    char magic[32];
    int version;
    if (fscanf(f, "%31s %d", magic, &version) != 2 || strcmp(magic, SAVE_MAGIC) != 0) {
        fclose(f); return SAVE_ERR_FORMAT;
    }
    if (version != SAVE_VERSION) { fclose(f); return SAVE_ERR_VERSION; }

    if (fscanf(f, "%d %d %d %d %d %d", &tmp.size, &tmp.winLength, &tmp.mode,
               &tmp.botLevel, &tmp.currentPlayer, &tmp.moveCount) != 6) {
        fclose(f); return SAVE_ERR_FORMAT;
    }
    if (tmp.size < 3 || tmp.size > MAX_SIZE || tmp.moveCount < 0 || tmp.moveCount > MAX_MOVES) {
        fclose(f); return SAVE_ERR_DATA;
    }

    for (int i = 0; i < tmp.size; i++)
        for (int j = 0; j < tmp.size; j++)
            if (fscanf(f, "%d", &tmp.board[i][j]) != 1) { fclose(f); return SAVE_ERR_FORMAT; }

    for (int k = 0; k < tmp.moveCount; k++)
        if (fscanf(f, "%d %d %d", &tmp.history[k].row, &tmp.history[k].col,
                   &tmp.history[k].player) != 3) { fclose(f); return SAVE_ERR_FORMAT; }

    char endTag[8];
    if (fscanf(f, "%7s", endTag) != 1 || strcmp(endTag, "END") != 0) {
        fclose(f); return SAVE_ERR_FORMAT;
    }
    fclose(f);

    if (!sg_validate(&tmp)) return SAVE_ERR_DATA;
    *g = tmp;
    return SAVE_OK;
}

static SaveResult saveToSlot(const GameState *g, int slot)
{
    char path[128];
    sg_slotPath(path, sizeof(path), slot);
    return saveGame(g, path);
}

static SaveResult loadFromSlot(GameState *g, int slot)
{
    char path[128];
    sg_slotPath(path, sizeof(path), slot);
    return loadGame(g, path);
}

static int slotExists(int slot)
{
    char path[128];
    sg_slotPath(path, sizeof(path), slot);
    FILE *f = sg_open(path, "r");
    if (!f) return 0;
    fclose(f);
    return 1;
}

static const char *saveResultMessage(SaveResult r)
{
    switch (r) {
        case SAVE_OK:               return "Thanh cong";
        case SAVE_ERR_OPEN:         return "Khong mo/ghi duoc file";
        case SAVE_ERR_FORMAT:       return "File sai dinh dang";
        case SAVE_ERR_VERSION:      return "File save khac phien ban";
        case SAVE_ERR_DATA:         return "Du lieu khong hop le";
        case SAVE_ERR_NOT_FOUND:    return "Khong tim thay file";
        case SAVE_ERR_KEY_CONFLICT: return "Phim da duoc gan cho hanh dong khac";
        default:                    return "Loi khong xac dinh";
    }
}

#define SETTINGS_FILE  SAVE_DIR "/settings.cfg"
#define SETTINGS_MAGIC "CARO_SETTINGS"
#define SETTINGS_VER   1

typedef enum {
    ACT_UP = 0, ACT_DOWN, ACT_LEFT, ACT_RIGHT,
    ACT_PLACE, ACT_UNDO, ACT_PAUSE, ACT_SAVE,
    ACT_COUNT
} KeyAction;

typedef struct {
    int keys[ACT_COUNT];
    int musicOn;
    int musicVolume;
    int soundOn;
    int soundVolume;
    int turnTimeLimit;
    int gameTimeLimit;
} Settings;

static int sg_validateSettings(const Settings *s)
{
    if (s->musicOn != 0 && s->musicOn != 1)                 return 0;
    if (s->soundOn != 0 && s->soundOn != 1)                 return 0;
    if (s->musicVolume < 0 || s->musicVolume > 100)         return 0;
    if (s->soundVolume < 0 || s->soundVolume > 100)         return 0;
    if (s->turnTimeLimit < 0 || s->turnTimeLimit > 3600)    return 0;
    if (s->gameTimeLimit < 0 || s->gameTimeLimit > 86400)   return 0;

    for (int i = 0; i < ACT_COUNT; i++) {
        if (s->keys[i] < 1 || s->keys[i] > 255) return 0;
        for (int j = i + 1; j < ACT_COUNT; j++)
            if (s->keys[i] == s->keys[j]) return 0;
    }
    return 1;
}

static const char *keyActionName(KeyAction a)
{
    static const char *names[ACT_COUNT] = {
        "Len", "Xuong", "Trai", "Phai", "Dat quan", "Undo", "Tam dung", "Luu game"
    };
    return (a >= 0 && a < ACT_COUNT) ? names[a] : "?";
}

static void initSettings(Settings *s)
{
    memset(s, 0, sizeof(*s));
    s->keys[ACT_UP]    = 'w';
    s->keys[ACT_DOWN]  = 's';
    s->keys[ACT_LEFT]  = 'a';
    s->keys[ACT_RIGHT] = 'd';
    s->keys[ACT_PLACE] = 13;
    s->keys[ACT_UNDO]  = 'u';
    s->keys[ACT_PAUSE] = 'p';
    s->keys[ACT_SAVE]  = 'k';
    s->musicOn = 1;  s->musicVolume = 70;
    s->soundOn = 1;  s->soundVolume = 70;
    s->turnTimeLimit = 0;
    s->gameTimeLimit = 0;
}

static SaveResult setKeybind(Settings *s, KeyAction a, int key)
{
    if (a < 0 || a >= ACT_COUNT || key < 1 || key > 255) return SAVE_ERR_DATA;
    for (int i = 0; i < ACT_COUNT; i++)
        if (i != (int)a && s->keys[i] == key) return SAVE_ERR_KEY_CONFLICT;
    s->keys[a] = key;
    return SAVE_OK;
}

static SaveResult setMusic(Settings *s, int on, int volume)
{
    if (volume < 0 || volume > 100) return SAVE_ERR_DATA;
    s->musicOn = on ? 1 : 0;
    s->musicVolume = volume;
    return SAVE_OK;
}

static SaveResult setSound(Settings *s, int on, int volume)
{
    if (volume < 0 || volume > 100) return SAVE_ERR_DATA;
    s->soundOn = on ? 1 : 0;
    s->soundVolume = volume;
    return SAVE_OK;
}

static SaveResult setTimeLimits(Settings *s, int turnSeconds, int gameSeconds)
{
    if (turnSeconds < 0 || turnSeconds > 3600)  return SAVE_ERR_DATA;
    if (gameSeconds < 0 || gameSeconds > 86400) return SAVE_ERR_DATA;
    s->turnTimeLimit = turnSeconds;
    s->gameTimeLimit = gameSeconds;
    return SAVE_OK;
}

static SaveResult saveSettings(const Settings *s)
{
    SG_MKDIR(SAVE_DIR);
    FILE *f = sg_open(SETTINGS_FILE, "w");
    if (!f) return SAVE_ERR_OPEN;

    fprintf(f, "%s %d\n", SETTINGS_MAGIC, SETTINGS_VER);
    for (int i = 0; i < ACT_COUNT; i++) fprintf(f, "%d ", s->keys[i]);
    fprintf(f, "\n%d %d %d %d\n", s->musicOn, s->musicVolume, s->soundOn, s->soundVolume);
    fprintf(f, "%d %d\n", s->turnTimeLimit, s->gameTimeLimit);
    fprintf(f, "END\n");

    int err = ferror(f);
    fclose(f);
    return err ? SAVE_ERR_OPEN : SAVE_OK;
}

static SaveResult loadSettings(Settings *s)
{
    FILE *f = sg_open(SETTINGS_FILE, "r");
    if (!f) { initSettings(s); return SAVE_ERR_NOT_FOUND; }

    Settings tmp;
    memset(&tmp, 0, sizeof(tmp));

    char magic[32];
    int version;
    if (fscanf(f, "%31s %d", magic, &version) != 2 || strcmp(magic, SETTINGS_MAGIC) != 0) {
        fclose(f); return SAVE_ERR_FORMAT;
    }
    if (version != SETTINGS_VER) { fclose(f); return SAVE_ERR_VERSION; }

    for (int i = 0; i < ACT_COUNT; i++)
        if (fscanf(f, "%d", &tmp.keys[i]) != 1) { fclose(f); return SAVE_ERR_FORMAT; }

    if (fscanf(f, "%d %d %d %d", &tmp.musicOn, &tmp.musicVolume,
               &tmp.soundOn, &tmp.soundVolume) != 4 ||
        fscanf(f, "%d %d", &tmp.turnTimeLimit, &tmp.gameTimeLimit) != 2) {
        fclose(f); return SAVE_ERR_FORMAT;
    }

    char endTag[8];
    if (fscanf(f, "%7s", endTag) != 1 || strcmp(endTag, "END") != 0) {
        fclose(f); return SAVE_ERR_FORMAT;
    }
    fclose(f);

    if (!sg_validateSettings(&tmp)) return SAVE_ERR_DATA;
    *s = tmp;
    return SAVE_OK;
}

#endif
