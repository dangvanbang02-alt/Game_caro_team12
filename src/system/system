#ifndef SAVEGAME_H
#define SAVEGAME_H

#include <stdio.h>
#include <string.h>

#ifdef _WIN32
  #include <direct.h>
  #define SG_MKDIR(path) _mkdir(path)
#else
  #include <sys/stat.h>
  #define SG_MKDIR(path) mkdir(path, 0755)
#endif

#define MAX_SIZE      20
#define MAX_MOVES     (MAX_SIZE * MAX_SIZE)
#define SAVE_DIR      "saves"
#define SAVE_MAGIC    "CARO_SAVE"
#define SAVE_VERSION  1

#define CELL_EMPTY 0
#define CELL_X     1
#define CELL_O     2

#define MODE_PVP 0
#define MODE_PVE 1

#define LEVEL_EASY   0
#define LEVEL_MEDIUM 1
#define LEVEL_HARD   2

typedef struct {
    int row, col, player;
} Move;

typedef struct {
    int  size;
    int  board[MAX_SIZE][MAX_SIZE];
    int  currentPlayer;
    int  mode;
    int  botLevel;
    int  winLength;
    int  moveCount;
    Move history[MAX_MOVES];
} GameState;

typedef enum {
    SAVE_OK = 0,
    SAVE_ERR_OPEN,
    SAVE_ERR_FORMAT,
    SAVE_ERR_VERSION,
    SAVE_ERR_DATA,
    SAVE_ERR_NOT_FOUND
} SaveResult;

static FILE *sg_open(const char *name, const char *mode)
{
    FILE *f = NULL;
#ifdef _MSC_VER
    if (fopen_s(&f, name, mode) != 0) return NULL;
#else
    f = fopen(name, mode);
#endif
    return f;
}

static int sg_validPlayer(int p) { return p == CELL_X || p == CELL_O; }

static int sg_validate(const GameState *g)
{
    if (g->size < 3 || g->size > MAX_SIZE)                    return 0;
    if (g->winLength < 3 || g->winLength > g->size)           return 0;
    if (!sg_validPlayer(g->currentPlayer))                    return 0;
    if (g->mode != MODE_PVP && g->mode != MODE_PVE)           return 0;
    if (g->botLevel < LEVEL_EASY || g->botLevel > LEVEL_HARD) return 0;
    if (g->moveCount < 0 || g->moveCount > g->size * g->size) return 0;

    for (int i = 0; i < g->size; i++)
        for (int j = 0; j < g->size; j++)
            if (g->board[i][j] < CELL_EMPTY || g->board[i][j] > CELL_O) return 0;

    for (int k = 0; k < g->moveCount; k++) {
        const Move *m = &g->history[k];
        if (m->row < 0 || m->row >= g->size) return 0;
        if (m->col < 0 || m->col >= g->size) return 0;
        if (!sg_validPlayer(m->player))      return 0;
    }
    return 1;
}

static void sg_slotPath(char *buf, size_t n, int slot)
{
    snprintf(buf, n, "%s/slot%d.sav", SAVE_DIR, slot);
}

static void initGame(GameState *g, int size, int winLength, int mode, int botLevel)
{
    memset(g, 0, sizeof(*g));
    g->size = size;
    g->winLength = winLength;
    g->mode = mode;
    g->botLevel = botLevel;
    g->currentPlayer = CELL_X;
}

static int applyMove(GameState *g, int row, int col)
{
    if (row < 0 || row >= g->size || col < 0 || col >= g->size) return 0;
    if (g->board[row][col] != CELL_EMPTY) return 0;
    if (g->moveCount >= MAX_MOVES) return 0;

    g->board[row][col] = g->currentPlayer;
    g->history[g->moveCount].row = row;
    g->history[g->moveCount].col = col;
    g->history[g->moveCount].player = g->currentPlayer;
    g->moveCount++;
    g->currentPlayer = (g->currentPlayer == CELL_X) ? CELL_O : CELL_X;
    return 1;
}

static SaveResult saveGame(const GameState *g, const char *filename)
{
    SG_MKDIR(SAVE_DIR);
    FILE *f = sg_open(filename, "w");
    if (!f) return SAVE_ERR_OPEN;

    fprintf(f, "%s %d\n", SAVE_MAGIC, SAVE_VERSION);
    fprintf(f, "%d %d %d %d %d %d\n", g->size, g->winLength, g->mode,
            g->botLevel, g->currentPlayer, g->moveCount);

    for (int i = 0; i < g->size; i++) {
        for (int j = 0; j < g->size; j++) fprintf(f, "%d ", g->board[i][j]);
        fprintf(f, "\n");
    }
    for (int k = 0; k < g->moveCount; k++)
        fprintf(f, "%d %d %d\n", g->history[k].row, g->history[k].col, g->history[k].player);
    fprintf(f, "END\n");

    int err = ferror(f);
    fclose(f);
    return err ? SAVE_ERR_OPEN : SAVE_OK;
}

static SaveResult loadGame(GameState *g, const char *filename)
{
    FILE *f = sg_open(filename, "r");
    if (!f) return SAVE_ERR_NOT_FOUND;

    GameState tmp;
    memset(&tmp, 0, sizeof(tmp));

    char magic[32];
    int version;
    if (fscanf(f, "%31s %d", magic, &version) != 2 || strcmp(magic, SAVE_MAGIC) != 0) {
        fclose(f); return SAVE_ERR_FORMAT;
    }
    if (version != SAVE_VERSION) { fclose(f); return SAVE_ERR_VERSION; }

    if (fscanf(f, "%d %d %d %d %d %d", &tmp.size, &tmp.winLength, &tmp.mode,
               &tmp.botLevel, &tmp.currentPlayer, &tmp.moveCount) != 6) {
        fclose(f); return SAVE_ERR_FORMAT;
    }
    if (tmp.size < 3 || tmp.size > MAX_SIZE || tmp.moveCount < 0 || tmp.moveCount > MAX_MOVES) {
        fclose(f); return SAVE_ERR_DATA;
    }

    for (int i = 0; i < tmp.size; i++)
        for (int j = 0; j < tmp.size; j++)
            if (fscanf(f, "%d", &tmp.board[i][j]) != 1) { fclose(f); return SAVE_ERR_FORMAT; }

    for (int k = 0; k < tmp.moveCount; k++)
        if (fscanf(f, "%d %d %d", &tmp.history[k].row, &tmp.history[k].col,
                   &tmp.history[k].player) != 3) { fclose(f); return SAVE_ERR_FORMAT; }

    char endTag[8];
    if (fscanf(f, "%7s", endTag) != 1 || strcmp(endTag, "END") != 0) {
        fclose(f); return SAVE_ERR_FORMAT;
    }
    fclose(f);

    if (!sg_validate(&tmp)) return SAVE_ERR_DATA;
    *g = tmp;               /* chi ghi de khi du lieu hop le */
    return SAVE_OK;
}

static SaveResult saveToSlot(const GameState *g, int slot)
{
    char path[128];
    sg_slotPath(path, sizeof(path), slot);
    return saveGame(g, path);
}

static SaveResult loadFromSlot(GameState *g, int slot)
{
    char path[128];
    sg_slotPath(path, sizeof(path), slot);
    return loadGame(g, path);
}

static int slotExists(int slot)
{
    char path[128];
    sg_slotPath(path, sizeof(path), slot);
    FILE *f = sg_open(path, "r");
    if (!f) return 0;
    fclose(f);
    return 1;
}

static const char *saveResultMessage(SaveResult r)
{
    switch (r) {
        case SAVE_OK:            return "Thanh cong";
        case SAVE_ERR_OPEN:      return "Khong mo/ghi duoc file";
        case SAVE_ERR_FORMAT:    return "File sai dinh dang";
        case SAVE_ERR_VERSION:   return "File save khac phien ban";
        case SAVE_ERR_DATA:      return "Du lieu trong file khong hop le";
        case SAVE_ERR_NOT_FOUND: return "Khong tim thay file save";
        default:                 return "Loi khong xac dinh";
    }
}

#endif 
